{
  "StartAt": "TestStart",
  "States": {
    "TestStart": {
      "Next": "Stabilization Map",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "Stabilization Map"
        }
      ],
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${metrics_emitter_arn}",
        "Payload": {
          "solutionId": "SO0062",
          "uuid": "${uuid}",
          "version": "custom-v4.3.5",
          "metricUrl": "https://metrics.awssolutionsbuilder.com/generic",
          "accountId": "${account_id}",
          "metricSchemaVersion": 1,
          "data": {
            "Type": "TestStart",
            "TestId.$": "$.testId",
            "RunMode.$": "$.runMode",
            "TestType.$": "$.testType",
            "FileType.$": "$.fileType",
            "TestDuration.$": "$.testDuration",
            "RegionCount.$": "States.ArrayLength($.testTaskConfig)"
          }
        }
      }
    },
    "Stabilization Map": {
      "Type": "Map",
      "ResultPath": "$.stabilizationResults",
      "Next": "Init Error Reason",
      "InputPath": "$",
      "ItemsPath": "$.testTaskConfig",
      "ItemSelector": {
        "testTaskConfig.$": "$$.Map.Item.Value",
        "testId.$": "$.testId",
        "testType.$": "$.testType",
        "fileType.$": "$.fileType",
        "showLive.$": "$.showLive",
        "testDuration.$": "$.testDuration",
        "prefix.$": "$.prefix",
        "testRunId.$": "$.testRunId",
        "hubTaskDefinition.$": "$.hubTaskDefinition",
        "nativeTaskDefinitions.$": "$.nativeTaskDefinitions",
        "nativeRunMode.$": "$.nativeRunMode"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Check Running Tests",
        "States": {
          "Check Running Tests": {
            "Next": "Test already running?",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "Prepare Phase 1 Failure Cleanup"
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "OutputPath": "$.Payload",
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${task_status_checker_arn}",
              "Payload.$": "$"
            }
          },
          "Test already running?": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.isRunning",
                "BooleanEquals": true,
                "Next": "Test Already Running End"
              }
            ],
            "Default": "Task Runner"
          },
          "Task Runner": {
            "Next": "Task Runner failed?",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "Prepare Phase 1 Failure Cleanup"
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "OutputPath": "$.Payload",
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${task_runner_arn}",
              "Payload.$": "$"
            }
          },
          "Task Runner failed?": {
            "Type": "Choice",
            "Choices": [
              {
                "And": [
                  {
                    "Variable": "$.status",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.status",
                    "StringEquals": "FAILED"
                  }
                ],
                "Next": "Phase 1 Map End"
              }
            ],
            "Default": "Check Stabilization"
          },
          "Check Stabilization": {
            "Next": "Service stable?",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "Prepare Phase 1 Failure Cleanup"
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "OutputPath": "$.Payload",
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${stabilization_checker_arn}",
              "Payload.$": "$"
            }
          },
          "Wait 10s - stabilization": {
            "Type": "Wait",
            "Seconds": 10,
            "Next": "Check Stabilization"
          },
          "Service stable?": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.status",
                "StringEquals": "READY",
                "Next": "Phase 1 Map End"
              },
              {
                "Variable": "$.status",
                "StringEquals": "FAILED",
                "Next": "Phase 1 Map End"
              }
            ],
            "Default": "Wait 10s - stabilization"
          },
          "Phase 1 Map End": {
            "Type": "Pass",
            "End": true
          },
          "Phase 1 Error Cleanup": {
            "Next": "Phase 1 Map End",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "ResultPath": null,
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${test_cleanup_arn}",
              "Payload.$": "$"
            }
          },
          "Prepare Phase 1 Failure Cleanup": {
            "Type": "Pass",
            "Parameters": {
              "testId.$": "$.testId",
              "testRunId.$": "$.testRunId",
              "testTaskConfig.$": "$.testTaskConfig",
              "finalStatus": "failed",
              "errorReason": "ECS service creation or stabilization failed",
              "skipStatusUpdate": true
            },
            "Next": "Phase 1 Error Cleanup"
          },
          "Test Already Running End": {
            "Type": "Pass",
            "Next": "Phase 1 Map End"
          }
        }
      }
    },
    "Init Error Reason": {
      "Type": "Pass",
      "Result": "",
      "ResultPath": "$.errorReason",
      "Next": "Regional Sync"
    },
    "Regional Sync": {
      "Next": "All regions ready?",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Set Error Reason: regional sync error"
        }
      ],
      "Type": "Task",
      "ResultPath": "$.syncResult",
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${regional_sync_arn}",
        "Payload": {
          "testId.$": "$.testId",
          "testRunId.$": "$.testRunId",
          "testType.$": "$.testType",
          "regions.$": "$.stabilizationResults"
        }
      }
    },
    "All regions ready?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.syncResult.Payload.allReady",
          "BooleanEquals": true,
          "Next": "Set Status: running"
        }
      ],
      "Default": "Set Error Reason: stabilization failed"
    },
    "Set Error Reason: stabilization failed": {
      "Type": "Pass",
      "ResultPath": "$.errorReason",
      "InputPath": "$.syncResult.Payload.errorReason",
      "Next": "Cancel All Regions"
    },
    "Cancel All Regions": {
      "Type": "Map",
      "ResultPath": null,
      "Next": "Final Outcome: failed",
      "InputPath": "$",
      "ItemsPath": "$.stabilizationResults",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Prepare Cancel Cleanup",
        "States": {
          "Prepare Cancel Cleanup": {
            "Type": "Pass",
            "Parameters": {
              "testId.$": "$.testId",
              "testRunId.$": "$.testRunId",
              "testTaskConfig.$": "$.testTaskConfig",
              "finalStatus": "failed",
              "errorReason": "Regional sync failed — at least one region did not stabilize",
              "skipStatusUpdate": true
            },
            "Next": "Cancel Region"
          },
          "Cancel Region": {
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "ResultPath": null,
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${test_cleanup_arn}",
              "Payload.$": "$"
            }
          }
        }
      }
    },
    "Set Error Reason: regional sync error": {
      "Type": "Pass",
      "Result": "Regional sync failed — at least one region did not stabilize",
      "ResultPath": "$.errorReason",
      "Next": "Cancel All Regions"
    },
    "Final Outcome: failed": {
      "Type": "Pass",
      "Result": "failed",
      "ResultPath": "$.finalOutcome",
      "Next": "TestEnd"
    },
    "Error Cleanup Map": {
      "Type": "Map",
      "ResultPath": null,
      "Next": "Final Outcome: failed",
      "InputPath": "$",
      "ItemsPath": "$.stabilizationResults",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Prepare Error Cleanup",
        "States": {
          "Prepare Error Cleanup": {
            "Type": "Pass",
            "Parameters": {
              "testId.$": "$.testId",
              "testRunId.$": "$.testRunId",
              "testTaskConfig.$": "$.testTaskConfig",
              "finalStatus": "failed",
              "errorReason.$": "$.errorReason",
              "skipStatusUpdate": true
            },
            "Next": "Invoke Error Cleanup"
          },
          "Invoke Error Cleanup": {
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "ResultPath": null,
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${test_cleanup_arn}",
              "Payload.$": "$"
            }
          }
        }
      }
    },
    "Test results succeeded?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.executionResult.hasFailures",
          "BooleanEquals": true,
          "Next": "Error Cleanup Map"
        },
        {
          "Variable": "$.error",
          "IsPresent": true,
          "Next": "Error Cleanup Map"
        }
      ],
      "Default": "Cleanup Map"
    },
    "Set Status: cleaning up": {
      "Next": "Test results succeeded?",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${test_status_updater_arn}",
        "Payload": {
          "testId.$": "$.testId",
          "testRunId.$": "$.testRunId",
          "status": "cleaning up"
        }
      }
    },
    "Parse Results": {
      "Next": "Set Status: cleaning up",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "Set Error Reason: results parsing failed"
        }
      ],
      "Type": "Task",
      "ResultPath": "$.parseResult",
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${results_parser_arn}",
        "Payload": {
          "testTaskConfig.$": "$.testTaskConfig",
          "testId.$": "$.testId",
          "testType.$": "$.testType",
          "fileType.$": "$.fileType",
          "showLive.$": "$.showLive",
          "testDuration.$": "$.testDuration",
          "prefix.$": "$.prefix",
          "testRunId.$": "$.testRunId",
          "executionStart.$": "$$.Execution.StartTime",
          "nativeRunMode.$": "$.nativeRunMode",
          "executionFailed.$": "$.executionResult.hasFailures"
        }
      }
    },
    "Set Status: parsing results": {
      "Next": "Parse Results",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${test_status_updater_arn}",
        "Payload": {
          "testId.$": "$.testId",
          "testRunId.$": "$.testRunId",
          "status": "parsing results"
        }
      }
    },
    "Set Error Reason: execution failed": {
      "Type": "Pass",
      "Result": "Test execution failed",
      "ResultPath": "$.errorReason",
      "Next": "Set Status: parsing results"
    },
    "Execution failed?": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.executionResult.hasFailures",
          "BooleanEquals": true,
          "Next": "Set Error Reason: execution failed"
        }
      ],
      "Default": "Set Status: parsing results"
    },
    "Check For Failures": {
      "Type": "Pass",
      "ResultPath": "$.executionResult",
      "Parameters": {
        "hasFailures.$": "States.ArrayContains($.executionMapResults, 'failed')"
      },
      "Next": "Execution failed?"
    },
    "Execution Map": {
      "Type": "Map",
      "ResultPath": "$.executionMapResults",
      "Next": "Check For Failures",
      "InputPath": "$",
      "ItemsPath": "$.stabilizationResults",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "Send START Command",
        "States": {
          "Send START Command": {
            "Next": "Check Completion",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "Prepare Start Command Failure"
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "ResultPath": null,
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${start_command_arn}",
              "Payload.$": "$"
            }
          },
          "Check Completion": {
            "Next": "Is test complete?",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "ResultPath": "$.error",
                "Next": "Prepare Completion Monitor Failure"
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "OutputPath": "$.Payload",
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${task_status_checker_arn}",
              "Payload.$": "$"
            }
          },
          "Wait - completion poll": {
            "Type": "Wait",
            "SecondsPath": "$.pollIntervalSeconds",
            "Next": "Check Completion"
          },
          "Is test complete?": {
            "Type": "Choice",
            "Choices": [
              {
                "And": [
                  {
                    "Variable": "$.isComplete",
                    "BooleanEquals": true
                  },
                  {
                    "Variable": "$.maxDurationReached",
                    "BooleanEquals": true
                  }
                ],
                "Next": "Set Final Status: failed"
              },
              {
                "Variable": "$.isComplete",
                "BooleanEquals": true,
                "Next": "Set Final Status: success"
              },
              {
                "Variable": "$.timedOut",
                "BooleanEquals": true,
                "Next": "Prepare Phase 2 Failure Cleanup"
              }
            ],
            "Default": "Wait - completion poll"
          },
          "Set Final Status: failed": {
            "Type": "Pass",
            "Parameters": {
              "finalStatus": "failed"
            },
            "Next": "Phase 2 Map End"
          },
          "Phase 2 Map End": {
            "Type": "Pass",
            "OutputPath": "$.finalStatus",
            "End": true
          },
          "Phase 2 Error Cleanup": {
            "Next": "Phase 2 Map End",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "ResultPath": null,
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${test_cleanup_arn}",
              "Payload.$": "$"
            }
          },
          "Prepare Phase 2 Failure Cleanup": {
            "Type": "Pass",
            "Parameters": {
              "testId.$": "$.testId",
              "testRunId.$": "$.testRunId",
              "testTaskConfig.$": "$.testTaskConfig",
              "finalStatus": "failed",
              "errorReason.$": "$.errorReason",
              "skipStatusUpdate": true
            },
            "Next": "Phase 2 Error Cleanup"
          },
          "Prepare Completion Monitor Failure": {
            "Type": "Pass",
            "Parameters": {
              "testId.$": "$.testId",
              "testRunId.$": "$.testRunId",
              "testTaskConfig.$": "$.testTaskConfig",
              "finalStatus": "failed",
              "errorReason": "Completion monitoring failed",
              "skipStatusUpdate": true
            },
            "Next": "Phase 2 Error Cleanup"
          },
          "Prepare Start Command Failure": {
            "Type": "Pass",
            "Parameters": {
              "testId.$": "$.testId",
              "testRunId.$": "$.testRunId",
              "testTaskConfig.$": "$.testTaskConfig",
              "finalStatus": "failed",
              "errorReason": "Failed to send start command",
              "skipStatusUpdate": true
            },
            "Next": "Phase 2 Error Cleanup"
          },
          "Set Final Status: success": {
            "Type": "Pass",
            "Parameters": {
              "finalStatus": "success"
            },
            "Next": "Phase 2 Map End"
          }
        }
      }
    },
    "Set Status: running": {
      "Next": "Execution Map",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${test_status_updater_arn}",
        "Payload": {
          "testId.$": "$.testId",
          "testRunId.$": "$.testRunId",
          "status": "running"
        }
      }
    },
    "Set Error Reason: results parsing failed": {
      "Type": "Pass",
      "Result": "Results parsing failed",
      "ResultPath": "$.errorReason",
      "Next": "Set Status: cleaning up"
    },
    "Cleanup Map": {
      "Type": "Map",
      "ResultPath": null,
      "Next": "Final Outcome: complete",
      "InputPath": "$",
      "ItemsPath": "$.stabilizationResults",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Prepare Complete Cleanup",
        "States": {
          "Prepare Complete Cleanup": {
            "Type": "Pass",
            "Parameters": {
              "testId.$": "$.testId",
              "testRunId.$": "$.testRunId",
              "testTaskConfig.$": "$.testTaskConfig",
              "finalStatus": "complete",
              "skipStatusUpdate": true
            },
            "Next": "Invoke Test Cleanup"
          },
          "Invoke Test Cleanup": {
            "End": true,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ClientExecutionTimeoutException",
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2
              }
            ],
            "Type": "Task",
            "InputPath": "$",
            "ResultPath": null,
            "Resource": "arn:${partition}:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${test_cleanup_arn}",
              "Payload.$": "$"
            }
          }
        }
      }
    },
    "Final Outcome: complete": {
      "Type": "Pass",
      "Result": "complete",
      "ResultPath": "$.finalOutcome",
      "Next": "TestEnd"
    },
    "TestEnd": {
      "Next": "Set Final Status and Endtime",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": null,
          "Next": "Set Final Status and Endtime"
        }
      ],
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${metrics_emitter_arn}",
        "Payload": {
          "solutionId": "SO0062",
          "uuid": "${uuid}",
          "version": "custom-v4.3.5",
          "metricUrl": "https://metrics.awssolutionsbuilder.com/generic",
          "accountId": "${account_id}",
          "metricSchemaVersion": 1,
          "data": {
            "Type": "TestEnd",
            "TestId.$": "$.testId",
            "TestType.$": "$.testType",
            "FinalStatus.$": "$.finalOutcome"
          }
        }
      }
    },
    "Set Final Status and Endtime": {
      "Next": "Done",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ClientExecutionTimeoutException",
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 6,
          "BackoffRate": 2
        }
      ],
      "Type": "Task",
      "ResultPath": null,
      "Resource": "arn:${partition}:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${test_status_updater_arn}",
        "Payload": {
          "testId.$": "$.testId",
          "testRunId.$": "$.testRunId",
          "status.$": "$.finalOutcome",
          "endTime.$": "$$.State.EnteredTime",
          "errorReason.$": "$.errorReason"
        }
      }
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
